#!/bin/bash

set -euo pipefail
. /.functions

# For SSL support
set_or_default SSL_DIR "/.ssl"

# No pre-set certificate, so we need to obtain one from the ACME service
init_ssl

export ETCD_SSL_ENABLED="true"
export ETCD_SSL_TLS_CERT="${SSL_CERTIFICATE}"
export ETCD_SSL_TLS_KEY="${SSL_PRIVATE_KEY}"
export ETCD_SSL_TLS_CA_CERT="${SSL_ROOT}"

export TLS_SERVER_PEM_PATH="${SSL_CERTIFICATE}"
export TLS_SERVER_KEY_PATH="${SSL_PRIVATE_KEY}"
export TLS_CA_PEM_PATH="${SSL_ROOT}"

export COMMON_SECURITY_INTERNALTLS_ENABLED="true"
export COMMON_SECURITY_TLS_MODE="1"
export INTERNALTLS_SERVER_PEM_PATH="${SSL_CERTIFICATE}"
export INTERNALTLS_SERVER_KEY_PATH="${SSL_PRIVATE_KEY}"
export INTERNALTLS_CA_PEM_PATH="${SSL_ROOT}"

CN="$(openssl x509 -in "${INTERNALTLS_SERVER_PEM_PATH}" -subject -noout -nameopt RFC2253 2>&1)" || fail "Failed to get the SSL certificate's CN (rc=${?}): ${CN}"
export INTERNALTLS_SNI="${CN##*=}"

export TIKV_SSL_TLS_CERT="${SSL_CERTIFICATE}"
export TIKV_SSL_TLS_KEY="${SSL_PRIVATE_KEY}"
export TIKV_SSL_TLS_CA_CERT="${SSL_ROOT}"

export PROXY_HTTP_PORT="8080"

#
# Slight adjustment for Minio stuff
#
if [ -n "${MINIO_URL:-}" ] ; then
	export EXPAND_URLS_PREFIX="MINIO_"
	. <(/usr/local/bin/expand-urls)

	[ -n "${MINIO_URL_HOST:-}" ] && export MINIO_ADDRESS="${MINIO_URL_HOST}"
	[ -n "${MINIO_URL_PORT:-}" ] && export MINIO_PORT="${MINIO_URL_PORT}"
	[ "${MINIO_URL_SCHEME:-}" == "https" ] \
		&& MINIO_USE_SSL="true" \
		|| MINIO_USE_SSL="false"
	export MINIO_USE_SSL

	if as_boolean "${MINIO_USE_SSL}" ; then
		export MINIO_SSL_TLS_CA_CERT="${SSL_ROOT}"
		export MINIO_SSL_TLS_MIN_VERSION="1.3"
	fi
fi

set_or_default MILVUS_MODE "standalone"

# Run the thing!
[ ${#} -gt 0 ] || set -- "run" "${MILVUS_MODE}"
execute milvus "${@}"
